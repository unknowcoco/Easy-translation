<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <RootNamespace>EasyTranslation</RootNamespace>
    <AssemblyName>EasyTranslation</AssemblyName>
    <AssemblyTitle>Easy translation</AssemblyTitle>
    <Product>Easy translation · 划词翻译替换</Product>
    <Description>Select text in any Windows app, right-click the EasyTranslation chip, and replace it with English or one of 18 target languages.</Description>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
